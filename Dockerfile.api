FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY apps/api apps/api
COPY data/cop31-events.json data/cop31-events.json
COPY data/cop31-import-2026-10-24.json data/cop31-import-2026-10-24.json
COPY data/cop31-b-lab-webinar-2026-10-29.json data/cop31-b-lab-webinar-2026-10-29.json
RUN npm run db:generate && npm run build -w @cop31/api

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production API_PORT=3000
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/data/cop31-events.json ./data/cop31-events.json
COPY --from=build /app/data/cop31-import-2026-10-24.json ./data/cop31-import-2026-10-24.json
COPY --from=build /app/data/cop31-b-lab-webinar-2026-10-29.json ./data/cop31-b-lab-webinar-2026-10-29.json
EXPOSE 3000
CMD ["sh", "-c", "npm run db:migrate && npm run db:seed && node apps/api/dist/main.js"]

