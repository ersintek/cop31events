{
  "name": "cop31-events",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @cop31/api && npm run build -w @cop31/web",
    "db:generate": "npm run db:generate -w @cop31/api",
    "db:migrate": "npm run db:migrate -w @cop31/api",
    "db:seed": "npm run db:seed -w @cop31/api",
    "db:local": "node scripts/start-local-db.mjs",
    "dev:api": "npm run start:dev -w @cop31/api",
    "dev:web": "npm run dev -w @cop31/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "prisma": "^6.12.0"
  }
}
